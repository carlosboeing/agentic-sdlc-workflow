{
  "name": "workflow-runtime-service",
  "version": "0.1.0",
  "description": "Persistent local server for agentic SDLC workflow — SQLite-backed PM, dashboard UI, MCP tools",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "migrate": "bun run src/db/migrate.ts",
    "generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "build:frontend": "bun run scripts/build-frontend.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "mermaid": "^11.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^4.3.5"
  }
}
