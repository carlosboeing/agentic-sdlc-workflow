{
  "$comment": "Board settings are empty on purpose: with no GitHub project board configured, scripts skip board operations. Copy values from .claude/agentic-sdlc-config.example.json to enable them. See docs/5-guides/running-safely-guide.md.",
  "workflowDir": ".workflow",
  "github": {
    "repo": "",
    "owner": "",
    "projectNumber": "",
    "projectId": "",
    "statusFieldId": ""
  },
  "boardStatus": {
    "backlog": "",
    "ready": "",
    "in-progress": "",
    "in-review": "",
    "done": ""
  },
  "modelRouting": {
    "easy": "sonnet",
    "medium": "sonnet",
    "hard": "opus"
  },
  "pm": {
    "adapter": "server"
  },
  "workflow": {
    "autoMergePlanPR": true,
    "autoMergeDesignPR": true,
    "skipRetro": false,
    "maxParallelBuilders": 3,
    "maxCostPerRun": null
  },
  "server": {
    "port": 3117,
    "portRange": [
      3117,
      3127
    ],
    "idleTimeoutMinutes": 240,
    "logLevel": "info"
  },
  "reviewStrategy": {
    "skipPerStoryReview": {
      "enabled": true,
      "conditions": {
        "maxDifficulty": "easy",
        "requireLabel": "test-agentic-sdlc"
      }
    }
  },
  "briefing": {
    "defaultDepth": "standard",
    "sources": {
      "roadmap": true,
      "changelog": true,
      "retroDocs": {
        "enabled": true,
        "maxCount": 2
      },
      "lessonFiles": {
        "enabled": true,
        "severityThreshold": "high"
      },
      "designDocs": true,
      "planDocs": true,
      "retroRecommendations": true,
      "openPRs": true,
      "board": true,
      "stateFile": true,
      "reviewerComments": true,
      "gitLog": false
    }
  }
}
