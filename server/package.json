{
  "name": "workflow-runtime-service",
  "version": "0.1.0",
  "description": "Persistent local server for agentic SDLC workflow — SQLite-backed PM, dashboard UI, MCP tools",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "migrate": "bun run src/db/migrate.ts",
    "generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "build:frontend": "bun run scripts/build-frontend.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^4.2.2"
  }
}
