{
  "$comment": "Defaults for a first run with no workflow server and no project board. pm.adapter is null, so work items are files under workflowDir and no script writes GitHub issues, labels or board items. The board fields are empty, so board operations are skipped. Branch pushes and pull requests still go to GitHub during a run. Every field is described under _fields in .claude/agentic-sdlc-config.example.json; see docs/5-guides/running-safely-guide.md.",
  "workflowDir": ".workflow",
  "github": {
    "repo": "",
    "owner": "",
    "projectNumber": "",
    "projectId": "",
    "statusFieldId": ""
  },
  "boardStatus": {
    "backlog": "",
    "ready": "",
    "in-progress": "",
    "in-review": "",
    "done": ""
  },
  "modelRouting": {
    "easy": "sonnet",
    "medium": "sonnet",
    "hard": "opus"
  },
  "pm": {
    "adapter": null
  },
  "server": {
    "port": 3117,
    "portRange": [
      3117,
      3127
    ],
    "idleTimeoutMinutes": 240,
    "logLevel": "info"
  },
  "reviewStrategy": {
    "skipPerStoryReview": {
      "enabled": true,
      "conditions": {
        "maxDifficulty": "easy",
        "requireLabel": "test-agentic-sdlc"
      }
    }
  },
  "briefing": {
    "defaultDepth": "standard",
    "sources": {
      "roadmap": true,
      "changelog": true,
      "retroDocs": {
        "enabled": true,
        "maxCount": 2
      },
      "lessonFiles": {
        "enabled": true,
        "severityThreshold": "high"
      },
      "designDocs": true,
      "planDocs": true,
      "retroRecommendations": true,
      "openPRs": true,
      "board": true,
      "stateFile": true,
      "reviewerComments": true,
      "gitLog": false
    }
  }
}
